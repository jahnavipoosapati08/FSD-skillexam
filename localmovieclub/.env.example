# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/movieclub
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
NODE_ENV=development
# Used only by: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
